# Remote Ollama server (used by both backends).
SSH_TARGET=your-user@your-ollama-host

# macOS UTM backend. Use absolute guest paths printed by bootstrap-macos.sh.
# VM_SSH_TARGET can be a host alias from your normal ~/.ssh/config.
VM_ID="Harness macOS"
VM_SSH_TARGET=harness@harness-vm.local
VM_SSH_KEY=~/.ssh/ai-harness-vm
VM_SSH_TIMEOUT=300
VM_PYTHON=/Users/harness/.local/share/ai-harness/venv/bin/python
VM_INSTALL_DIR=/Users/harness/.local/share/ai-harness
VM_WORK_DIR=/Users/harness/harness-work
